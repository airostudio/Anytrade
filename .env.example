# ── Database (required) ──────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance: Supabase, Neon, RDS, or a local server.
# Local example:  postgresql://postgres@localhost:5432/anytrade?sslmode=disable
DATABASE_URL="postgresql://user:password@host:5432/anytrade"

# Optional: maximum pooled connections (default 10). Lower it on serverless.
# PGPOOL_MAX=10

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
# The canonical origin of the deployment, used in callback links.
NEXTAUTH_URL="http://localhost:3000"

# ── Passcode gates (REQUIRED to open /admin and /homegirls) ──────────────────
# Both sections sit behind a shared passcode on top of normal sign-in. There is
# NO default: leave these unset and the gates stay locked to everyone.
# At least 12 characters each:  openssl rand -base64 18 | tr -d '/+='
# The environment takes precedence over anything saved in Admin → Settings.
ADMIN_PASSCODE=""
HOMEGIRLS_PASSCODE=""

# ── Stripe (optional) ────────────────────────────────────────────────────────
# Without these the app runs in DEMO MODE: checkout completes instantly without
# charging a card, and every purchase is recorded exactly as a real one would be.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Site ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs (Stripe redirects, metadata). Falls back to NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe Connect: platform country for tradie payout accounts (default AU).
# STRIPE_CONNECT_COUNTRY="AU"
