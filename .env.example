# Database - Get from Supabase (required for production)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional - for future payment features)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Prisma - Required for Vercel builds
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# Note: For Vercel deployment, add all environment variables above
# in your Vercel project settings under Environment Variables
